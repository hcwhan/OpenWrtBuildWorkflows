
tailscale 包 files/tailscale.init(上游 GuNanOvO/openwrt-tailscale 的 package/tailscale/files/tailscale.init)的补丁.
应用: 2.feeds-insert-script.sh 的 # tailscale 段, patch -p1 -F0 在 tailscale 包目录下应用, 上下文与上游不匹配时构建失败.
作用: start_service 读取 UCI 选项 settings.gogc 和 settings.gomemlimit, 非空时在 procd 实例的环境变量里追加 GOGC 和 GOMEMLIMIT, 限制 tailscaled 的内存占用; 选项没有设置时不追加.
说明: GOGC 越小, 堆比上次 GC 后允许增长的比例越小, 堆占用越小, GC 次数越多; GOMEMLIMIT 是 Go 运行时内存的软上限, 接近上限时 GC 更频繁, 负载高时仍可能超出.
前提: 出厂的 /etc/config/tailscale 不含这两个选项, 由 files/dev-<设备名>/etc/uci-defaults/ 里的脚本为需要的设备写入.
本补丁只新增行, 不改动已有行.

--- a/files/tailscale.init
+++ b/files/tailscale.init
@@ -13,6 +13,7 @@
   local state_file
   local port
   local std_err std_out
+  local gogc gomemlimit

   config_load tailscale
   config_get_bool std_out "settings" log_stdout 1
@@ -20,6 +21,8 @@
   config_get port "settings" port 41641
   config_get state_file "settings" state_file /etc/tailscale/tailscaled.state
   config_get fw_mode "settings" fw_mode nftables
+  config_get gogc "settings" gogc
+  config_get gomemlimit "settings" gomemlimit

   /usr/sbin/tailscaled --cleanup

@@ -33,6 +36,10 @@
   # Disable logging to log.tailscale.com
   procd_append_param env TS_NO_LOGS_NO_SUPPORT=true

+  # GOGC, GOMEMLIMIT 是 Go 运行时的内存参数, 仅在 UCI 里设置了 gogc, gomemlimit 时传给 tailscaled.
+  [ -n "$gogc" ] && procd_append_param env GOGC="$gogc"
+  [ -n "$gomemlimit" ] && procd_append_param env GOMEMLIMIT="$gomemlimit"
+
   # Set the port to listen on for incoming VPN packets.
   # Remote nodes will automatically be informed about the new port number,
   # but you might want to configure this in order to set external firewall
