#!/bin/sh /etc/rc.common

# 开机时按 /etc/config/tailscale 的 settings.service_enabled 决定 tailscale 要不要自启:
# 为 0 就删掉 /etc/rc.d/S80tailscale 链接, 紧随其后的 S80 就不会启动 tailscaled; 为 1 或选项不存在时什么也不做.
# service_enabled 由 luci-app-tailscale-community 的页面写入, 选项不存在(从没在页面保存过)时按 1(开启)处理.
#
# 为什么需要: tailscale 包的 init 脚本里没有"是否自启"的配置项, 自启只取决于 /etc/rc.d/S80tailscale 链接,
# 这个链接由镜像构建时的 default_postinst 生成, 与 service_enabled 无关.
# tailscale-settings 在 LuCI 里关闭服务时会 disable 这个链接, 但链接被新镜像重新带来(例如刷机保留配置后)时, 它不会再执行.
#
# 为什么早于 80 就有效: procd 开机时先列出所有 /etc/rc.d/S*, 再逐个顺序执行, 执行那一刻才按路径启动,
# 所以 S70 先删掉 S80tailscale 链接, 轮到 S80 时路径已不存在, 启动会失败并被跳过.
#
# 只删链接, 不停止进程, 不改配置. 重新开启服务时, tailscale-settings 会 enable 并启动 tailscale.
# 只实现 boot(), 只在开机时执行; 手动 start / restart 和 opkg 安装后的 start 都是空操作. 手动验证用 /etc/init.d/tailscale-boot-gate boot.
# 本脚本由 3.feeds-after-script.sh 放进 luci-app-tailscale-community 包的 root/ 下随包安装, 镜像构建时会自动生成 /etc/rc.d/S70tailscale-boot-gate 链接.

START=70

boot() {
  local service_enabled
  config_load tailscale
  config_get_bool service_enabled settings service_enabled 1
  [ "$service_enabled" = 1 ] && return 0
  /etc/init.d/tailscale enabled || return 0
  /etc/init.d/tailscale disable
  logger -t tailscale-boot-gate "service_enabled=0, removed boot link of tailscale"
}
