
tailscale 包 Makefile(上游 GuNanOvO/openwrt-tailscale 的 package/tailscale/Makefile)的补丁.
应用: feeds-insert-script.sh 的 # tailscale 段, patch -p1 -F0 在 tailscale 包目录下应用, 上下文与上游不匹配时构建失败.
作用: 去掉 Makefile 里写死的 UPX 字样, 共两处:
1. GO_PKG_LDFLAGS 里版本串的 "(OpenWrt-UPX)" 改成 "(OpenWrt)".
2. Package/tailscale 的 TITLE 由 "Zero config VPN (UPX Compressed)" 改成 "Zero config VPN".
原因: 这两处都是上游写死的标签, 与是否实际做了 UPX 压缩无关(本项目构建并未压缩). 版本串改成与 ImmortalWrt 自带包一致的 "(OpenWrt)".

--- a/Makefile
+++ b/Makefile
@@ -26,7 +26,7 @@
 PKG_BUILD_FLAGS:=no-mips16
 
 GO_PKG:=tailscale.com/cmd/tailscaled
-GO_PKG_LDFLAGS:=-s -w -X 'tailscale.com/version.longStamp=$(PKG_VERSION)-$(PKG_RELEASE) (OpenWrt-UPX)'
+GO_PKG_LDFLAGS:=-s -w -X 'tailscale.com/version.longStamp=$(PKG_VERSION)-$(PKG_RELEASE) (OpenWrt)'
 GO_PKG_LDFLAGS_X:=tailscale.com/version.shortStamp=$(PKG_VERSION)
 # Note: keep ts_omit_relayserver out of this list - it removes the Relay server
 # feature (Peer Relay). It was removed in 1.102.4-r2 after issue #161.
@@ -43,7 +43,7 @@
   SECTION:=net
   CATEGORY:=Network
   SUBMENU:=VPN
-  TITLE:=Zero config VPN (UPX Compressed)
+  TITLE:=Zero config VPN
   URL:=https://github.com/GuNanOvO/openwrt-tailscale
   DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +kmod-tun
   PROVIDES:=tailscale tailscaled
